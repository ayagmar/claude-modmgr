{
  "name": "modmgr-repo",
  "private": true,
  "description": "Development tooling for modmgr, a Claude Code mod manager. The shipped plugin lives in ./plugin and has no package.json.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc -p plugin --noEmit && tsc -p test/plugin --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "validate": "node scripts/validate-plugin.ts",
    "test:plugin": "node scripts/test-plugin.ts",
    "explanations": "node scripts/gen-explanations.ts",
    "gate": "pnpm lint && pnpm typecheck && pnpm coverage && pnpm validate && pnpm test:plugin",
    "fixtures:plugin-tests": "node scripts/fixtures-to-plugin-tests.ts",
    "demo": "RENDER_DEMO=1 vitest run test/demo",
    "site": "pnpm --filter modmgr-site build && node scripts/check-site.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
