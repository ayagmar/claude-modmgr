---
import '../styles/global.css'
import { notableText } from '../../../plugin/hooks/domain/capabilities.ts'
import { MIN_CLAUDE_VERSION } from '../../../plugin/hooks/domain/version.ts'
import Keymap from '../components/Keymap.astro'
import Terminal from '../components/Terminal.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const INSTALL = '/plugin install modmgr --marketplace ayagmar/modmgr'
// A flag stays with its value when the line wraps; built as one string, since
// whitespace from the template would show inside the <pre>.
const INSTALL_HTML = INSTALL.split(' --')
  .map((part, index) => `<span class="keep">${index === 0 ? part : `--${part}`}</span>`)
  .join(' ')
const REPO = 'https://github.com/ayagmar/modmgr'
const description =
  'modmgr finds, installs, inspects, toggles and updates the mods that run inside your Claude Code sessions, and says what each one can do before it runs.'
const NOTABLE = [
  'runs-programs',
  'reads-and-sends',
  'secret-env',
  'changes-model-input',
  'judges-plugins',
  'starts-model-calls',
].map(notableText)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>modmgr: a mod manager for Claude Code</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href="https://ayagmar.github.io/modmgr/" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="modmgr: a mod manager for Claude Code" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://ayagmar.github.io/modmgr/" />
    <meta property="og:image" content="https://ayagmar.github.io/modmgr/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#eef0ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121615" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // The toggle's choice, before paint; without script the system decides.
      try {
        const theme = localStorage.getItem('theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="wrap top">
      <a class="mark" href={`${base}/`} aria-label="modmgr, home">modmgr</a>
      <nav aria-label="Elsewhere">
        <a href={REPO}>Source</a>
        <a href={`${REPO}/blob/main/CHANGELOG.md`}>Changes</a>
        <button class="theme" type="button" hidden aria-pressed="false">Dark theme</button>
      </nav>
    </header>

    <main id="main">
      <div class="wrap hero">
        <div class="pitch">
          <h1>Every mod in your Claude&nbsp;Code, and what it can do.</h1>
          <p class="lead">
            Mods are plugins that hook into a Claude Code session: they can run programs, read the
            conversation, change what the model sees. modmgr shows you which ones you have, what
            each one is able to do, and lets you install, switch off, update or remove them without
            leaving the session.
          </p>
          <div class="install">
            <p id="install-label">Type this at the Claude Code prompt:</p>
            <div class="line">
              <pre aria-labelledby="install-label"><code id="install-line" set:html={INSTALL_HTML} /></pre>
              <button class="copy" type="button" hidden data-copy="install-line">Copy</button>
            </div>
            <p class="small">
              Then <code>/mods</code>. Needs Claude Code {MIN_CLAUDE_VERSION} or newer.
            </p>
          </div>
        </div>
        <div class="demo">
          <Terminal />
        </div>
      </div>

      <section aria-labelledby="why">
        <div class="wrap">
          <h2 id="why">Why a manager for mods</h2>
          <dl class="points">
            <div>
              <dt>Know what runs</dt>
              <dd>
                Each mod's events and calls are read from Claude Code's own validator and grouped by
                what they reach: your machine, the network, the conversation, the model's input,
                other plugins. The combinations worth a second look are named up front.
              </dd>
            </div>
            <div>
              <dt>Find mods where they are</dt>
              <dd>
                Discover lists the mods in every marketplace you have added. The official catalogues'
                mods are known at once from an index rebuilt daily; anything else is checked while you
                work, search matches first. A local entry is read before you install it.
              </dd>
            </div>
            <div>
              <dt>Change things without surprises</dt>
              <dd>
                Toggles are staged and applied together, with one plugin reload after. Anything that
                runs new code or removes something is shown to you first, and the last batch can be
                undone.
              </dd>
            </div>
          </dl>
        </div>
      </section>

      <section aria-labelledby="trust">
        <div class="wrap split">
          <div>
            <h2 id="trust">An update that adds power is news</h2>
            <p>
              modmgr remembers what each mod could do at the version you had. When an update adds
              something notable, the mod's row, the line above your prompt and the status line say
              so, in plain words: <q>turn-band can now run programs</q>. It stays said until you open
              that mod's detail.
            </p>
            <p>What it calls out:</p>
            <ul class="notable">
              {NOTABLE.map(text => <li>{text}</li>)}
            </ul>
          </div>
          <div class="aside">
            <p>
              A marketplace can declare a command that runs to fetch a plugin. modmgr shows that
              command whole, with its sha256, and runs it only when you confirm that exact command.
              It never answers yes for you.
            </p>
            <p>
              modmgr is a lens, not a sandbox: once a mod runs, it runs with your session's power.
              The <a href={`${REPO}/blob/main/docs/SECURITY.md`}>security notes</a> say what modmgr
              reads, fetches and stores.
            </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="features">
        <div class="wrap">
          <h2 id="features">What's in /mods</h2>
          <dl class="features">
            <div>
              <dt>Installed</dt>
              <dd>Every mod with its state, version and scope; its detail lists what it hooks and calls, each with one line of explanation.</dd>
            </div>
            <div>
              <dt>Discover</dt>
              <dd>Search and sort the catalogues of all your marketplaces; install at user, project or local scope after a review; add a marketplace.</dd>
            </div>
            <div>
              <dt>Dev</dt>
              <dd>The mods you are writing, loaded from a folder: validate, run their tests, reload, and get the one line someone else needs to install yours.</dd>
            </div>
            <div>
              <dt>Health</dt>
              <dd>What needs you, worst first: validate errors, failures while a mod reloads, updates, hook order that matters, each with a fix one key away.</dd>
            </div>
            <div>
              <dt>Updates</dt>
              <dd>Marketplaces are checked every few hours while no turn is running; the line above the prompt says how many mods can update.</dd>
            </div>
            <div>
              <dt>As text</dt>
              <dd><code>/mods list</code>, <code>info</code>, <code>doctor --json</code>, <code>export</code> and writes behind <code>--yes</code>, for scripts and <code>claude -p</code>.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section aria-labelledby="keys">
        <div class="wrap">
          <h2 id="keys">Keys</h2>
          <p>
            Everything in <code>/mods</code> is a button you can click, and most have a key. Arrows and
            Tab move, Enter opens, Esc steps back.
          </p>
          <Keymap />
        </div>
      </section>

      <section aria-labelledby="faq">
        <div class="wrap faq">
          <h2 id="faq">Questions</h2>
          <details>
            <summary>How is this different from <code>/plugin</code>?</summary>
            <p>
              <code>/plugin</code> manages every kind of plugin. modmgr is only about mods, the plugins
              with a hooks module, and adds what you need to trust them: what each can do, what an
              update changed, reviews before anything runs, undo, and a single reload after a batch
              of changes. It does every change through the same <code>claude plugin</code> commands.
            </p>
          </details>
          <details>
            <summary>Does modmgr use the network?</summary>
            <p>
              Three things fetch. The update check asks the <code>claude</code> CLI to refresh your
              marketplaces every few hours. Discover reads modmgr's catalogue index (one file, at most
              every 12 hours) and a catalogue entry's <code>hooks.json</code>, both from
              <code>raw.githubusercontent.com</code>, the entries at most 600 times a session and only
              while no turn runs. All of it stops when
              <code>CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC</code> is set, and the last two with the
              <code>detectRemote</code> option off. modmgr sends no telemetry.
            </p>
          </details>
          <details>
            <summary>Can it make a mod safe?</summary>
            <p>
              No. It tells you what a mod can do and asks before anything new runs; it does not limit
              what a running mod does. Remove what you don't trust.
            </p>
          </details>
          <details>
            <summary>What does it need?</summary>
            <p>
              Claude Code {MIN_CLAUDE_VERSION} or newer, with the <code>claude</code> CLI on your path.
              Without the CLI, <code>/mods</code> still shows what you have, read-only, and says why.
            </p>
          </details>
          <details>
            <summary>Where do I write my own mod?</summary>
            <p>
              Anywhere you like: run Claude Code with <code>--plugin-dir</code> pointing at the folder
              and it shows up in Dev, where you can validate it, run its tests and get its install
              line.
            </p>
          </details>
        </div>
      </section>
    </main>

    <footer class="wrap foot">
      <p>
        modmgr is MIT-licensed. <a href={REPO}>Source and issues on GitHub</a>.
      </p>
    </footer>

    <script is:inline>
      // Copy and the theme toggle; the page works without them.
      for (const button of document.querySelectorAll('[data-copy]')) {
        const source = document.getElementById(button.dataset.copy)
        if (!source || !navigator.clipboard) continue
        button.hidden = false
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(source.textContent)
            button.textContent = 'Copied'
          } catch {
            button.textContent = 'Select and copy'
          }
          setTimeout(() => (button.textContent = 'Copy'), 2000)
        })
      }
      const toggle = document.querySelector('.theme')
      if (toggle) {
        const root = document.documentElement
        const dark = () =>
          root.dataset.theme
            ? root.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches
        const show = () => {
          toggle.setAttribute('aria-pressed', String(dark()))
          toggle.textContent = dark() ? 'Light theme' : 'Dark theme'
        }
        toggle.hidden = false
        show()
        toggle.addEventListener('click', () => {
          root.dataset.theme = dark() ? 'light' : 'dark'
          try {
            localStorage.setItem('theme', root.dataset.theme)
          } catch {}
          show()
        })
      }
    </script>
  </body>
</html>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.25rem;
  }

  .mark {
    font: 700 1.125rem var(--mono);
    color: var(--ink);
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem 1.25rem;
    align-items: center;
    font-size: 0.95rem;
  }

  .theme {
    font: inherit;
    color: var(--ink);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
  }

  .hero {
    display: grid;
    /* The terminal scrolls inside itself; it never widens the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* The dialog takes the whole width under the pitch: it is drawn 96 cells wide, as docked. */
  @media (min-width: 64rem) {
    .pitch {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: 3.5rem;
      align-items: end;
    }

    .pitch h1 {
      grid-row: span 2;
      align-self: start;
    }
  }

  h1 {
    font-size: clamp(2.1rem, 1.4rem + 3vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 2rem;
  }

  .install p {
    margin: 0 0 0.5rem;
  }

  .line {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }

  .line pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0.8rem 1rem;
    background: var(--term-bg);
    color: var(--term-fg);
    border-radius: 8px;
    font-size: 0.95rem;
    /* The whole line, wrapped where it must: it is what people copy. A flag
       stays with its value, never broken at its hyphens. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .line :global(.keep) {
    white-space: nowrap;
  }

  .copy {
    font: 600 0.95rem var(--sans);
    color: var(--accent-ink);
    background: var(--accent);
    border: 0;
    border-radius: 8px;
    padding: 0 1rem;
    cursor: pointer;
  }

  .small {
    font-size: 0.92rem;
    color: var(--muted);
    margin-top: 0.75rem !important;
  }

  .points,
  .features {
    display: grid;
    gap: 1.75rem 3rem;
    margin: 0;
  }

  @media (min-width: 52rem) {
    .points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  dt {
    font-weight: 650;
    margin-bottom: 0.35rem;
  }

  dd {
    margin: 0;
    color: var(--muted);
  }

  .notable {
    padding-left: 1.2rem;
    margin: 0;
  }

  .notable li::marker {
    content: '◆  ';
    color: var(--accent);
  }

  .aside {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
    align-self: start;
  }

  .aside p:first-child {
    margin-top: 0;
  }

  .faq details {
    border-bottom: 1px solid var(--rule);
    padding-block: 0.9rem;
    max-width: var(--measure);
  }

  .faq summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq details p {
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  .foot {
    border-top: 1px solid var(--rule);
    padding-block: 2rem 3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
