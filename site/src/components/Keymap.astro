---
// The keymap, from the one table the plugin draws its keys from
// (plugin/hooks/domain/keymap.ts): it can't drift from /mods.
import { BINDINGS, type KeySurface } from '../../../plugin/hooks/domain/keymap.ts'

const WHERE: Readonly<Record<KeySurface, string | undefined>> = {
  pane: 'anywhere in /mods',
  installed: 'Installed',
  discover: 'Discover',
  'discover-empty': undefined,
  dev: 'Dev',
  health: 'Health',
  detail: 'a mod’s detail',
  'discover-detail': 'an entry’s detail',
  'dev-detail': 'a dev mod’s detail',
  share: 'sharing',
  review: 'a review',
  help: undefined,
  jobs: 'the job log',
  band: 'the line above the prompt',
}

const rows = BINDINGS.map(binding => ({
  key: binding.hotkey ?? binding.key ?? '',
  label: binding.label,
  where: [...new Set(binding.on.map(surface => WHERE[surface]).filter(Boolean))].join(', '),
}))
---

<div class="scroll" tabindex="0" role="region" aria-label="Keys">
  <table>
    <thead>
      <tr><th scope="col">Key</th><th scope="col">Does</th><th scope="col">Where</th></tr>
    </thead>
    <tbody>
      {
        rows.map(row => (
          <tr>
            <td><kbd>{row.key}</kbd></td>
            <td>{row.label}</td>
            <td class="where">{row.where}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .scroll {
    overflow-x: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    max-width: 52rem;
    font-size: 0.95rem;
  }

  th {
    text-align: left;
    font-weight: 600;
    color: var(--muted);
    padding: 0 1rem 0.5rem 0;
    border-bottom: 1px solid var(--rule);
  }

  td {
    padding: 0.4rem 1rem 0.4rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  td:first-child {
    white-space: nowrap;
  }

  .where {
    color: var(--muted);
  }
</style>
