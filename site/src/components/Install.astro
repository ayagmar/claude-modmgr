---
// The install line, as people copy it: the copy button is hidden without script.
// `compact` is the slim one under the hero's headline.
import { flagParts, INSTALL } from '../lib/present.ts'

type Props = { id: string; label: string; compact?: boolean }
const { id, label, compact = false } = Astro.props

// A flag stays with its value when the line wraps, and no word breaks inside
// itself; built as one string, since whitespace from the template would show
// inside the <pre>.
const words = (part: string) =>
  part
    .split(' ')
    .map(word => `<span class="word">${word}</span>`)
    .join(' ')
const INSTALL_HTML = flagParts(INSTALL)
  .map(part => `<span class="keep">${words(part)}</span>`)
  .join(' ')
---

<div class:list={['install', { compact }]} data-copy-scope>
  <p class="vh" id={`${id}-label`}>{label}</p>
  <pre aria-labelledby={`${id}-label`}><code id={id} data-copy-text set:html={INSTALL_HTML} /></pre>
  <button class="btn copy js-only" type="button" data-copy aria-label="Copy the install line">
    <svg class="i" aria-hidden="true"><use href="#i-copy"></use></svg><span>Copy</span>
  </button>
</div>

<style>
  .install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 40rem;
    margin-inline: auto;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    background: var(--field);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
  }

  pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 0.9375rem);
    line-height: 1.5;
    text-align: left;
    /* The whole line, wrapped where it must: it is what people copy. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  pre::before {
    content: '> ';
    color: var(--accent-text);
  }

  .install :global(.keep),
  .install :global(.word) {
    white-space: nowrap;
  }

  .copy {
    height: 2.25rem;
  }

  .compact {
    display: inline-flex;
    gap: 0.5rem;
    max-width: 100%;
    padding: 0.25rem 0.25rem 0.25rem 0.85rem;
    border-radius: 10px;
  }

  .compact pre {
    font-size: 0.8125rem;
  }

  .compact .copy {
    height: 2rem;
  }

  /* On a phone the line keeps the room: the button keeps its icon, and its label
     for assistive tech, as the top bar's does. */
  @media (max-width: 30rem) {
    .compact .copy {
      width: 2rem;
      padding: 0;
    }

    .compact .copy span {
      display: none;
    }
  }

  /* The narrowest phones: a flag may leave its value for the next line, at the space. */
  @media (max-width: 23.5rem) {
    .compact :global(.keep) {
      white-space: normal;
    }
  }
</style>
