---
import '../styles/global.css'
import { notableText, REACH_LABEL, REACH_ORDER } from '../../../plugin/hooks/domain/capabilities.ts'
import { MIN_CLAUDE_VERSION } from '../../../plugin/hooks/domain/version.ts'
import Install from '../components/Install.astro'
import Keymap from '../components/Keymap.astro'
import Terminal from '../components/Terminal.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const REPO = 'https://github.com/ayagmar/claude-modmgr'
const description =
  'modmgr finds, installs, inspects, toggles and updates the mods that run inside your Claude Code sessions, and says what each one can do before it runs.'
const NOTABLE = [
  'runs-programs',
  'reads-and-sends',
  'secret-env',
  'changes-model-input',
  'judges-plugins',
  'starts-model-calls',
].map(notableText)
const REACHES = REACH_ORDER.map(reach => REACH_LABEL[reach])
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>modmgr: a mod manager for Claude Code</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href="https://ayagmar.github.io/claude-modmgr/" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="modmgr: a mod manager for Claude Code" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://ayagmar.github.io/claude-modmgr/" />
    <meta property="og:image" content="https://ayagmar.github.io/claude-modmgr/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2b632" />
    <script is:inline>
      // The toggle's choice, before paint; without script the system decides.
      try {
        const theme = localStorage.getItem('theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="cover">
      <div class="wrap top">
        <a class="name" href={`${base}/`} aria-label="modmgr, home">modmgr</a>
        <nav aria-label="Elsewhere">
          <a href={REPO}>Source</a>
          <a href={`${REPO}/blob/main/CHANGELOG.md`}>Changes</a>
          <a href={`${REPO}/blob/main/docs/SECURITY.md`}>Security</a>
          <button class="theme" type="button" hidden aria-pressed="false">Dark</button>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="cover hero">
        <div class="wrap pitch">
          <h1>Know what every mod in your Claude&nbsp;Code can do.</h1>
          <p class="lead">
            Mods are plugins that hook into a Claude Code session: they can run programs, read the
            conversation and change what the model sees. modmgr lists the ones you have, says what
            each one can do, and lets you find, install, switch off, update or remove them without
            leaving the session.
          </p>
          <div class="act">
            <Install id="install-line" label="Type this at the Claude Code prompt:" />
            <p class="then">
              Then <code>/mods</code>. Needs Claude Code {MIN_CLAUDE_VERSION} or newer, with the
              <code>claude</code> CLI on your path.
            </p>
          </div>
        </div>
      </div>

      <section class="plates" aria-labelledby="plates">
        <div class="wrap">
          <h2 id="plates" class="vh">The dialog, plate by plate</h2>
          <Terminal />
          <p class="source">
            Each plate is the real dialog, drawn by modmgr's own tests over a set of fixture mods.
          </p>
        </div>
      </section>

      <section aria-labelledby="marks">
        <div class="wrap marks">
          <div class="marks-text">
            <h2 id="marks">The marks it calls out</h2>
            <p>
              modmgr reads each mod's hooks and calls from Claude Code's own validator,
              <code>claude plugin validate --json</code>, and files every one under what it reaches.
              When a combination is worth a second look, the mod's detail names it in plain words.
            </p>
            <p>
              It also remembers what a mod could do at the version you had. When an update adds
              something notable, the mod's row, the line above your prompt and the status line say
              so: <q><i class="id">turn-band</i> can now run programs</q>. It stays said until you open that mod's detail.
            </p>
          </div>
          <div class="key">
            <h3>Notable</h3>
            <ul class="notable">
              {NOTABLE.map(text => <li>{text}</li>)}
            </ul>
            <h3>Filed under</h3>
            <p class="reach">{REACHES.join(' · ')}</p>
          </div>
        </div>
      </section>

      <section class="limits" aria-labelledby="limits">
        <div class="wrap side">
          <h2 id="limits">What it can't do, and won't</h2>
          <div>
          <ol class="cautions">
            <li>
              <h3>It can't contain a mod</h3>
              <p>
                modmgr is a lens, not a sandbox. An enabled mod runs with your session's power, and
                modmgr can't watch it or stop it mid-session. To stop one, disable or remove it and
                reload.
              </p>
            </li>
            <li>
              <h3>It won't answer yes for you</h3>
              <p>
                A marketplace can declare a command that runs to fetch a plugin. modmgr shows that
                command whole, with its sha256, and runs it only when you confirm that exact command.
              </p>
            </li>
            <li>
              <h3>It fetches little, and sends no telemetry</h3>
              <p>
                It runs only the <code>claude</code> CLI and never writes a settings file itself. Its
                own reads, from <code>raw.githubusercontent.com</code>, are the catalogue index and a
                catalogue entry's <code>hooks/hooks.json</code> and
                <code>.claude-plugin/plugin.json</code>. They carry nothing about your mods.
              </p>
            </li>
          </ol>
          <p class="more">
            <a href={`${REPO}/blob/main/docs/SECURITY.md`}>The security notes</a> say what modmgr reads,
            fetches and stores.
          </p>
          </div>
        </div>
      </section>

      <section aria-labelledby="tabs">
        <div class="wrap side">
          <h2 id="tabs">What's in /mods</h2>
          <dl class="tabs">
            <div>
              <dt>Installed <span class="cite">Plates I, II</span></dt>
              <dd>Every mod with its state, version and scope; its detail lists what it hooks and calls, each with one line of explanation. Changes are staged and applied together, with one plugin reload after.</dd>
            </div>
            <div>
              <dt>Discover <span class="cite">Plates III, IV</span></dt>
              <dd>The mods in every marketplace you have added. The official catalogues' mods are known at once from an index rebuilt daily; anything else is checked while you work, search matches first. Install at user, project or local scope after a review.</dd>
            </div>
            <div>
              <dt>Dev</dt>
              <dd>The mods you are writing, loaded from a folder: validate them, run their tests, reload, and get the one line someone else needs to install yours.</dd>
            </div>
            <div>
              <dt>Health <span class="cite">Plate V</span></dt>
              <dd>What needs you, worst first: validate errors, failures while a mod reloads, updates, each with a fix one key away.</dd>
            </div>
            <div>
              <dt>Updates</dt>
              <dd>Marketplaces are checked every few hours while no turn is running; the line above the prompt says how many mods can update.</dd>
            </div>
            <div>
              <dt>As text</dt>
              <dd><code>/mods list</code>, <code>info</code>, <code>doctor --json</code>, <code>export</code>, and writes behind <code>--yes</code>, for scripts and <code>claude -p</code>.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section aria-labelledby="keys">
        <div class="wrap side">
          <h2 id="keys">Keys</h2>
          <div>
            <p>
              Everything in <code>/mods</code> is a button you can click, and most have a key. Arrows
              and Tab move, Enter opens, Esc steps back, <kbd>1</kbd> to <kbd>4</kbd> switch tabs, and
              <kbd>h</kbd> lists every key inside <code>/mods</code>.
            </p>
            <details class="all-keys">
              <summary>Every key, and where it works</summary>
              <Keymap />
            </details>
          </div>
        </div>
      </section>

      <section aria-labelledby="faq">
        <div class="wrap side faq">
          <h2 id="faq">Questions</h2>
          <div>
          <details>
            <summary>How is this different from <code>/plugin</code>?</summary>
            <p>
              <code>/plugin</code> manages every kind of plugin. modmgr is only about mods, the plugins
              with a hooks module, and adds what you need to trust them: what each can do, what an
              update changed, reviews before anything runs, undo, and a single reload after a batch
              of changes. It does every change through the same <code>claude plugin</code> commands.
            </p>
          </details>
          <details>
            <summary>Does modmgr use the network?</summary>
            <p>
              Three things fetch. The update check asks the <code>claude</code> CLI to refresh your
              marketplaces every few hours. Discover reads modmgr's catalogue index (one file, at most
              every 12 hours) and a catalogue entry's <code>hooks.json</code>, both from
              <code>raw.githubusercontent.com</code>, the entries at most 600 times a session and only
              while no turn runs. All of it stops when
              <code>CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC</code> is set, and the last two with the
              <code>detectRemote</code> option off. modmgr sends no telemetry.
            </p>
          </details>
          <details>
            <summary>Can it make a mod safe?</summary>
            <p>
              No. It tells you what a mod can do and asks before anything new runs; it does not limit
              what a running mod does. Remove what you don't trust.
            </p>
          </details>
          <details>
            <summary>What does it need?</summary>
            <p>
              Claude Code {MIN_CLAUDE_VERSION} or newer, with the <code>claude</code> CLI on your path.
              Without the CLI, <code>/mods</code> still shows what you have, read-only, and says why.
            </p>
          </details>
          <details>
            <summary>Where do I write my own mod?</summary>
            <p>
              Anywhere you like: run Claude Code with <code>--plugin-dir</code> pointing at the folder
              and it shows up in Dev, where you can validate it, run its tests and get its install
              line.
            </p>
          </details>
          </div>
        </div>
      </section>

      <section class="cover close" aria-labelledby="install">
        <div class="wrap">
          <h2 id="install">Install it</h2>
          <Install id="install-line-close" label="At the Claude Code prompt:" />
          <p class="then">Then type <code>/mods</code>.</p>
        </div>
      </section>
    </main>

    <footer class="wrap foot">
      <p>modmgr is MIT-licensed. <a href={REPO}>Source and issues on GitHub</a>.</p>
    </footer>

    <script is:inline>
      // Copy and the theme toggle; the page works without them.
      for (const button of document.querySelectorAll('[data-copy]')) {
        const source = document.getElementById(button.dataset.copy)
        if (!source || !navigator.clipboard) continue
        button.hidden = false
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(source.textContent)
            button.textContent = 'Copied'
          } catch {
            button.textContent = 'Select and copy'
          }
          setTimeout(() => (button.textContent = 'Copy'), 2000)
        })
      }
      const toggle = document.querySelector('.theme')
      if (toggle) {
        const root = document.documentElement
        const dark = () =>
          root.dataset.theme
            ? root.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches
        const show = () => {
          toggle.setAttribute('aria-pressed', String(dark()))
          toggle.textContent = dark() ? 'Light' : 'Dark'
        }
        toggle.hidden = false
        show()
        toggle.addEventListener('click', () => {
          root.dataset.theme = dark() ? 'light' : 'dark'
          try {
            localStorage.setItem('theme', root.dataset.theme)
          } catch {}
          show()
        })
      }
    </script>
  </body>
</html>

<style>
  /* The guide's cover cloth: a band of marigold, its own ink. */
  .cover {
    background: var(--cover);
    color: var(--cover-ink);
  }

  .cover a {
    color: var(--cover-ink);
    text-decoration-color: var(--cover-ink);
  }

  .cover :focus-visible {
    outline-color: var(--cover-ink);
  }

  .cover :not(pre) > code {
    background: rgb(27 22 8 / 0.1);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--cover-rule);
  }

  .name {
    font-weight: 800;
    font-size: 1.35rem;
    font-stretch: 72%;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 1.25rem;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 550;
  }

  .theme {
    font: inherit;
    color: var(--cover-ink);
    background: none;
    border: 1px solid var(--cover-ink);
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  @media (max-width: 30rem) {
    nav {
      gap: 0.4rem 0.85rem;
      font-size: 0.9rem;
    }

    .name {
      font-size: 1.15rem;
    }
  }

  .theme:hover {
    background: var(--cover-ink);
    color: var(--cover);
  }

  .hero {
    padding-block: clamp(2.25rem, 1rem + 4vw, 4.5rem) clamp(2rem, 1rem + 2.5vw, 3rem);
  }

  .pitch {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 4rem;
  }

  @media (min-width: 64rem) {
    .pitch {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: start;
    }

    .pitch h1 {
      grid-column: 1 / -1;
      margin-bottom: 1rem;
    }
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 1.2rem + 4.4vw, 5.25rem);
    font-weight: 800;
    font-stretch: 68%;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .lead {
    margin: 0;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.55;
    max-width: 38rem;
  }

  .act {
    margin-top: 0.25rem;
  }

  .then {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
    color: var(--cover-muted);
  }

  /* The plates sit on the cover's lower edge, then on paper. */
  .plates {
    padding-top: 0;
    background: linear-gradient(var(--cover) 0 6.5rem, transparent 6.5rem);
  }

  .source {
    margin: 1.5rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .marks {
    display: grid;
    gap: 2.5rem 5rem;
  }

  @media (min-width: 60rem) {
    .marks {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .marks-text p {
    font-size: 1.1rem;
  }

  .key {
    align-self: start;
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 1.5rem 1.6rem 1.6rem;
  }

  .key h3 {
    font-size: 0.85rem;
    font-weight: 750;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .key h3 + ul {
    margin-bottom: 1.75rem;
  }

  .notable {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .notable li {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.6rem;
    font-weight: 550;
  }

  /* The dialog's own glyph for a notable capability. */
  .notable li::before {
    content: '◆';
    color: var(--ink);
    font-size: 0.8em;
    line-height: 2;
  }

  .reach {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* The limits: on the plates' own black. */
  .limits {
    background: var(--band);
    color: var(--term-fg);
    --rule: var(--term-rule);
    --muted: #a6acaf;
    border-top: 0;
  }

  .limits + section {
    border-top: 0;
  }

  .limits h2 {
    color: var(--mark);
    max-width: 18ch;
  }

  .limits a {
    color: var(--term-fg);
  }

  .limits :focus-visible {
    outline-color: var(--mark);
  }

  .limits :not(pre) > code {
    background: #23272b;
  }

  /* Cautions: numbered like the plates' legends, in the margin. */
  .cautions {
    list-style: none;
    counter-reset: caution;
    margin: 0;
    padding: 0;
  }

  .cautions li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .cautions li {
    counter-increment: caution;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .cautions li::before {
    content: counter(caution);
    grid-row: span 2;
    font-size: 1.6rem;
    font-weight: 800;
    font-stretch: 68%;
    line-height: 1.1;
    color: var(--mark);
    font-variant-numeric: tabular-nums;
  }

  .cautions h3 {
    font-size: 1.2rem;
    margin: 0.2rem 0 0.4rem;
  }

  .cautions p {
    margin: 0;
    color: var(--muted);
  }

  .more {
    margin: 2.5rem 0 0;
  }

  .tabs {
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .tabs > div {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .tabs > div {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .tabs dt {
    font-weight: 750;
    font-size: 1.2rem;
    font-stretch: 78%;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .cite {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-stretch: 85%;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .tabs dd {
    margin: 0;
    color: var(--muted);
  }

  /* The back of the guide: headings in the left column, matter on the right. */
  @media (min-width: 64rem) {
    .side {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2.6fr);
      gap: 0 4rem;
      align-items: start;
    }

    .side > h2 {
      position: sticky;
      top: 1.5rem;
    }
  }

  .side > div > p:first-child {
    margin-top: 0;
  }

  .all-keys {
    margin-top: 1.5rem;
    border-top: 2px solid var(--ink);
  }

  .all-keys summary {
    cursor: pointer;
    font-weight: 650;
    padding-block: 1rem;
  }

  .faq details {
    border-bottom: 1px solid var(--rule);
  }

  .faq details:first-of-type {
    border-top: 2px solid var(--ink);
  }

  .faq summary {
    cursor: pointer;
    font-weight: 650;
    font-size: 1.1rem;
    padding-block: 1rem;
    list-style-position: outside;
    margin-left: 1.1rem;
  }

  .faq summary::marker {
    color: var(--muted);
  }

  .faq details p {
    color: var(--muted);
    margin: 0 0 1.25rem 1.1rem;
  }

  .close {
    border-top: 0;
  }

  .close h2 {
    font-size: clamp(2.2rem, 1.2rem + 4vw, 4.2rem);
    font-stretch: 68%;
    line-height: 0.95;
    margin-bottom: 1.75rem;
  }

  .foot {
    padding-block: 2rem 3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .foot p {
    margin: 0;
  }
</style>
