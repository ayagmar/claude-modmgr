---
// The install line, as people copy it: the copy button is hidden without script.
import { flagParts, INSTALL } from '../lib/present.ts'

type Props = { id: string; label: string }
const { id, label } = Astro.props

// A flag stays with its value when the line wraps; built as one string, since
// whitespace from the template would show inside the <pre>.
const INSTALL_HTML = flagParts(INSTALL)
  .map(part => `<span class="keep">${part}</span>`)
  .join(' ')
---

<div class="install" data-copy-scope>
  <p class="vh" id={`${id}-label`}>{label}</p>
  <pre aria-labelledby={`${id}-label`}><code id={id} data-copy-text set:html={INSTALL_HTML} /></pre>
  <button class="btn copy js-only" type="button" data-copy aria-label="Copy the install line">
    <svg class="i" aria-hidden="true"><use href="#i-copy"></use></svg><span>Copy</span>
  </button>
</div>

<style>
  .install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 40rem;
    margin-inline: auto;
    padding: 0.5rem 0.5rem 0.5rem 1.1rem;
    background: var(--field);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
  }

  pre {
    flex: 1;
    min-width: 0;
    margin: 0;
    font-size: clamp(0.8125rem, 0.75rem + 0.3vw, 0.9375rem);
    line-height: 1.5;
    text-align: left;
    /* The whole line, wrapped where it must: it is what people copy. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  pre::before {
    content: '> ';
    color: var(--accent-text);
  }

  .install :global(.keep) {
    white-space: nowrap;
  }

  .copy {
    height: 2.25rem;
  }
</style>
